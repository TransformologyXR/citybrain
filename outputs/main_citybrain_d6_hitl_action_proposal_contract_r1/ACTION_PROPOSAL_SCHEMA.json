{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "action_proposal_id": {
      "type": "string"
    },
    "affected_entity_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "allowed_human_decisions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "created_by_task": {
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "forbidden_action_flags": {
      "type": "object"
    },
    "limitation_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "not_an_action_statement": {
      "type": "string"
    },
    "proposal_type": {
      "enum": [
        "review_next_look",
        "request_more_evidence",
        "draft_advisory_for_review",
        "review_route_context",
        "review_access_constraint",
        "review_operator_note"
      ],
      "type": "string"
    },
    "review_state": {
      "enum": [
        "proposal_created",
        "awaiting_human_review",
        "approved_for_stub_only",
        "rejected_by_human",
        "modification_requested",
        "more_evidence_requested",
        "execution_stub_recorded",
        "monitor_review_context",
        "closed_review_context",
        "blocked_for_policy"
      ],
      "type": "string"
    },
    "scenario_id": {
      "const": "HERO-LON-CORRIDOR-LANE-BLOCKAGE-REPLAY-001"
    },
    "source_event_ref": {
      "type": "string"
    }
  },
  "required": [
    "action_proposal_id",
    "scenario_id",
    "source_event_ref",
    "affected_entity_refs",
    "evidence_refs",
    "limitation_refs",
    "proposal_type",
    "proposal_text",
    "allowed_human_decisions",
    "review_state",
    "confidence_summary",
    "risk_notes",
    "not_an_action_statement",
    "forbidden_action_flags",
    "created_by_task"
  ],
  "title": "CityBrain Track D HITL Action Proposal",
  "type": "object"
}
