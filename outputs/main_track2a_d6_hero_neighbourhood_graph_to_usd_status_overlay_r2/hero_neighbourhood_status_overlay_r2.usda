#usda 1.0
(
    doc = "CityBrain Track A graph-to-USD review-safe status overlay R2; local/replay review context only"
)

def Xform "CityBrainHeroNeighbourhoodStatusOverlayR2"
{
    custom string citybrain:scenarioId = "HERO-LON-CORRIDOR-LANE-BLOCKAGE-REPLAY-001"
    custom string citybrain:claimBoundary = "\"Track A is a bounded Hero Neighbourhood local/replay review-context spatial proof. It is not production Omniverse deployment, public API readiness, live/autonomous monitoring, alerting, dispatch, routing/control, enforcement, official ticket/case creation, legal/certified conclusion, automated action, citywide twin, or certified digital twin.\""
    def Xform "Status_001_event_replay_context"
    {
        custom string citybrain:overlayId = "graph-to-usd-status-overlay-r2-001"
        custom string citybrain:targetPrimPath = "/World/CityBrainHeroNeighbourhoodRealUsdTwinR1/Footprints/001_lon_corridor_scene_focus"
        custom string citybrain:reviewSafeStatus = "event_replay_context"
        custom color4f citybrain:displayColor = (0.950, 0.610, 0.180, 1.000)
        custom bool citybrain:noActionTaken = true
    }
    def Xform "Status_002_review_context_active"
    {
        custom string citybrain:overlayId = "graph-to-usd-status-overlay-r2-002"
