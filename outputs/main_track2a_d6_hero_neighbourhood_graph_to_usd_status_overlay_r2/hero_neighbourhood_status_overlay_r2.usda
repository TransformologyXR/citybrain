        custom string citybrain:reviewSafeStatus = "review_context_active"
        custom color4f citybrain:displayColor = (0.170, 0.450, 0.950, 1.000)
        custom bool citybrain:noActionTaken = true
    }
    def Xform "Status_003_review_context_active"
    {
