{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TXR City Brain \u2014 Canonical Schema v1",
  "$defs": {
    "Confidence": {
      "description": "Confidence in the entity's identity (or a resolution edge), with reason.\n1.0 exact-key vs ~0.7 geometry-only is the L2 upgrade over Phase 1.",
      "properties": {
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "method": {
          "$ref": "#/$defs/ResolutionMethod"
        },
        "basis": {
          "description": "Human-readable reason for the score.",
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "score",
        "method",
        "basis"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "Domain": {
      "description": "Source domain \u2014 kept on every provenance record so a unified entity still\ncarries which silo each field came from (replaces Phase 1's tool-level\nPROHIBITED_COMBOS with field-level provenance).",
      "enum": [
        "land",
        "dld",
        "dm",
        "civic",
        "mobility",
        "public_safety",
        "utility",
        "perception",
        "base_layer",
        "synthetic"
      ],
      "title": "Domain",
      "type": "string"
    },
    "EntityStatus": {
      "enum": [
        "active",
        "reserved"
      ],
      "title": "EntityStatus",
      "type": "string"
    },
    "Geometry": {
      "description": "GeoJSON-style geometry. Full geometry where the source/base layer provides\nit; a representative `point` ([lon, lat]) is ALWAYS present so the registry\ncan spatially resolve anything, even key-less records.\n(`coordinates` is intentionally loose for v1; tighten to per-type unions later.)",
      "properties": {
        "type": {
          "$ref": "#/$defs/GeometryType"
        },
        "coordinates": {
          "description": "GeoJSON coordinates; shape depends on `type`.",
          "title": "Coordinates"
        },
        "point": {
          "description": "Guaranteed representative point [lon, lat].",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Point",
          "type": "array"
        },
        "crs": {
          "default": "EPSG:4326",
          "title": "Crs",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates",
        "point"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "GeometryType": {
      "enum": [
        "Point",
        "LineString",
        "Polygon",
        "MultiPolygon"
      ],
      "title": "GeometryType",
      "type": "string"
    },
    "Provenance": {
      "description": "Field-level provenance. One record per contributing source. Carries the\nraw source key (`source_id`) \u2014 this is where native keys live now.",
      "properties": {
        "source_dataset": {
          "title": "Source Dataset",
          "type": "string"
        },
        "source_id": {
          "description": "Native record id/key in that source (e.g. BBL, BIN).",
          "title": "Source Id",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/Domain"
        },
        "source_fields": {
          "items": {
            "type": "string"
          },
          "title": "Source Fields",
          "type": "array"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "derivation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How a value was derived, e.g. 'BBL = borough+block+lot'.",
          "title": "Derivation"
        },
        "ingest_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ingest Run Id"
        }
      },
      "required": [
        "source_dataset",
        "source_id",
        "domain"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ResolutionMethod": {
      "description": "How an entity's identity (or a resolution edge) was established \u2014 drives\nthe confidence score. The thing Phase 1's bare-string model could not do.",
      "enum": [
        "exact_key",
        "derived_key",
        "point_in_polygon",
        "nearest",
        "fuzzy_match",
        "asserted",
        "exact_bin",
        "job_number",
        "complaint_number",
        "license_number",
        "address_fallback",
        "spatial_fallback",
        "name_hash"
      ],
      "title": "ResolutionMethod",
      "type": "string"
    },
    "Parcel": {
      "additionalProperties": false,
      "properties": {
        "canonical_id": {
          "pattern": "^[a-z_]+:[a-z]{2}-[a-z]{2,4}:[a-z0-9_]+:.+$",
          "title": "Canonical Id",
          "type": "string"
        },
        "entity_type": {
          "const": "parcel",
          "default": "parcel",
          "title": "Entity Type",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EntityStatus",
          "default": "active"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ext": {
          "additionalProperties": true,
          "description": "Namespaced extension fields, e.g. {'nyc.zonedist1': 'R3A'}.",
          "title": "Ext",
          "type": "object"
        },
        "land_use": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Land Use"
        },
        "zoning": {
          "items": {
            "type": "string"
          },
          "title": "Zoning",
          "type": "array"
        },
        "lot_area_sqft": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lot Area Sqft"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "development_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Development Ref"
        }
      },
      "required": [
        "canonical_id",
        "confidence"
      ],
      "title": "Parcel",
      "type": "object"
    },
    "Building": {
      "additionalProperties": false,
      "properties": {
        "canonical_id": {
          "pattern": "^[a-z_]+:[a-z]{2}-[a-z]{2,4}:[a-z0-9_]+:.+$",
