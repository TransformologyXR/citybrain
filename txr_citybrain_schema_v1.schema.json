    "EventCategory": {
      "description": "Closed, city-agnostic top-level class \u2014 the stable contract the agent\nroutes on. Aligns with the action core's entry points.",
      "enum": [
        "observation",
        "incident",
        "request",
        "transaction",
        "planned"
      ],
      "title": "EventCategory",
      "type": "string"
    },
    "EventSeverity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "EventSeverity",
      "type": "string"
    },
    "Event": {
      "additionalProperties": false,
      "description": "The workhorse. Absorbs complaints, 311, collisions, speed readings,\ndispatches, planned events, and DLD transactions \u2014 six source types, one\nentity. Two-level taxonomy: category (closed) + type (open). Resolution to\nentities is via resolves_to / affects EDGES (which carry the confidence).",
      "properties": {
        "canonical_id": {
          "pattern": "^[a-z_]+:[a-z]{2}-[a-z]{2,4}:[a-z0-9_]+:.+$",
          "title": "Canonical Id",
          "type": "string"
        },
        "entity_type": {
          "const": "event",
          "default": "event",
          "title": "Entity Type",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lifecycle: open/closed/resolved.",
          "title": "Status"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ext": {
          "additionalProperties": true,
          "description": "Namespaced extension fields, e.g. {'nyc.zonedist1': 'R3A'}.",
          "title": "Ext",
          "type": "object"
        },
        "category": {
          "$ref": "#/$defs/EventCategory"
        },
        "type": {
          "description": "Specific, source/city-specific kind, e.g. 'construction_complaint', 'vehicle_collision'.",
