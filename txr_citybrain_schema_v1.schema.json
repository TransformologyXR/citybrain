          "default": "party",
          "title": "Entity Type",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EntityStatus",
          "default": "active"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ext": {
          "additionalProperties": true,
          "description": "Namespaced extension fields, e.g. {'nyc.zonedist1': 'R3A'}.",
          "title": "Ext",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "party_type": {
          "$ref": "#/$defs/PartyType"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Strong key when present.",
          "title": "License Id"
        },
        "license_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. GC, PE, RA.",
          "title": "License Type"
        },
        "contact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contact"
        }
      },
      "required": [
        "canonical_id",
        "confidence",
        "name",
        "party_type"
      ],
      "title": "Party",
      "type": "object"
    },
    "Inspection": {
      "additionalProperties": false,
      "description": "First-class; inspector optional. Target is polymorphic (permit/building/\nestablishment \u2014 validated against restaurant inspection data).",
      "properties": {
