        "permit_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permit Type"
        },
        "job_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Type"
        },
        "permit_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permit Status"
        },
        "work_types": {
          "items": {
            "type": "string"
          },
          "title": "Work Types",
          "type": "array"
        },
        "filing_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filing Date"
        },
        "issuance_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuance Date"
        },
        "expiration_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiration Date"
        },
        "initial_cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Cost"
        },
        "floor_area_sqft": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Area Sqft"
        }
      },
      "required": [
        "canonical_id",
        "confidence"
      ],
      "title": "Permit",
      "type": "object"
    },
    "PartyType": {
      "enum": [
        "person",
        "organization"
      ],
      "title": "PartyType",
      "type": "string"
    },
    "Party": {
      "additionalProperties": false,
      "description": "Person or organisation. Role is NOT stored here \u2014 it lives on the edge.",
      "properties": {
        "canonical_id": {
          "pattern": "^[a-z_]+:[a-z]{2}-[a-z]{2,4}:[a-z0-9_]+:.+$",
          "title": "Canonical Id",
          "type": "string"
        },
        "entity_type": {
