          "type": "string"
        },
        "entity_type": {
          "const": "building",
          "default": "building",
          "title": "Entity Type",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EntityStatus",
          "default": "active"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ext": {
          "additionalProperties": true,
          "description": "Namespaced extension fields, e.g. {'nyc.zonedist1': 'R3A'}.",
          "title": "Ext",
          "type": "object"
        },
        "parcel_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parcel Ref"
        },
        "building_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Building Class"
        },
        "num_floors": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Num Floors"
        },
        "year_built": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year Built"
        },
        "units_residential": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units Residential"
        },
        "units_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units Total"
        },
        "height_ft": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Ft"
        },
        "development_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Development Ref"
        }
      },
      "required": [
        "canonical_id",
        "confidence"
      ],
      "title": "Building",
      "type": "object"
    },
    "Permit": {
      "additionalProperties": false,
      "properties": {
        "canonical_id": {
          "pattern": "^[a-z_]+:[a-z]{2}-[a-z]{2,4}:[a-z0-9_]+:.+$",
