# Copy to local env only. Do not commit secrets.
# Preferred endpoint mode:
CITYBRAIN_SPARK_VSS_ENDPOINT=http://<spark-host>:<port>/<path>

# Alternative command mode:
# CITYBRAIN_SPARK_VSS_COMMAND=/path/to/spark_vss_wrapper --input-json {input_json} --output-json {output_json}

# Optional tuning:
CITYBRAIN_SPARK_VSS_TIMEOUT_SECONDS=30
CITYBRAIN_SPARK_VSS_MAX_RESPONSE_BYTES=65536
