# CityBrain Spark VSS runtime config template
# Do not commit real secrets.

# Option A: command wrapper mode
# CITYBRAIN_SPARK_VSS_COMMAND="python /path/to/vss_wrapper.py --input-json {input_json} --output-json {output_json}"

# Option B: endpoint mode
# CITYBRAIN_SPARK_VSS_ENDPOINT="http://<spark-host>:<port>/<vss-route>"

# Optional non-secret metadata
# CITYBRAIN_SPARK_VSS_HOST_LABEL="spark"
# CITYBRAIN_SPARK_VSS_TIMEOUT_SECONDS="60"
