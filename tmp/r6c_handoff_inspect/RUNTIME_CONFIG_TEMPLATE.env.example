# Runtime config template for R6C / R7
# Copy to a local untracked env file. Do not commit secrets.

# Endpoint mode
CITYBRAIN_VSS_ENDPOINT=
CITYBRAIN_VSS_HEALTH_PATH=/health
CITYBRAIN_VSS_TIMEOUT_SECONDS=20

# Command mode
# Example shape only. Replace with the real local VSS health/probe command.
CITYBRAIN_VSS_COMMAND=

# Notes:
# - Endpoint or command is required for PASS.
# - CLI flags may override these variables.
# - Secrets must not be written to artifacts.
