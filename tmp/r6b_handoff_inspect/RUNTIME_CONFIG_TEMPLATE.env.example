# CityBrain VSS runtime configuration template for R6B.
# Choose endpoint OR command. Do not commit secrets.

# Endpoint mode
# CITYBRAIN_VSS_ENDPOINT=http://127.0.0.1:8000
# CITYBRAIN_VSS_HEALTH_PATH=/health

# Command mode
# CITYBRAIN_VSS_COMMAND=python path/to/vss_health_probe.py

CITYBRAIN_VSS_TIMEOUT_SECONDS=10
CITYBRAIN_VSS_PROBE_MODE=connectivity_only
CITYBRAIN_VSS_REDACT_CONFIG=true
