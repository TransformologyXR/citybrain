#usda 1.0
(
    defaultPrim = "CityBrainBrowserNavTest"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "CityBrainBrowserNavTest"
{
    def Cube "TestCube"
    {
        double size = 2
        float3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "ReferencePillar"
    {
        double size = 0.35
        float3 xformOp:scale = (1, 6, 1)
        float3 xformOp:translate = (3, 3, 0)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
    }

    def Cube "GroundMarker"
    {
        double size = 0.2
        float3 xformOp:scale = (18, 1, 18)
        float3 xformOp:translate = (0, -0.05, 0)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
    }
}
