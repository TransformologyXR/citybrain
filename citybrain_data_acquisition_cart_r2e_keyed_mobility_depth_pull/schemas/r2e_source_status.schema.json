{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R2E source status row",
  "type": "object",
  "required": [
    "source_id",
    "provider",
    "status",
    "auth_status",
    "endpoint_template",
    "secret_redacted",
    "raw_policy"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "auth_status": {
      "type": "string"
    },
    "http_status": {},
    "pages_fetched": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "row_count_estimate": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "endpoint_template": {
      "type": "string"
    },
    "secret_redacted": {},
    "raw_policy": {
      "type": "string"
    }
  }
}