{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArmingReadout",
  "type": "object",
  "required": [
    "capability_id",
    "snapshot_id",
    "snapshot_ref",
    "evaluator_version",
    "thresholds_not_reimplemented",
    "armed",
    "failed_requirement_ids"
  ],
  "properties": {
    "capability_id": {"type": "string"},
    "snapshot_id": {"type": "string"},
    "snapshot_ref": {"type": "string"},
    "evaluator_version": {"type": "string"},
    "thresholds_not_reimplemented": {"const": true},
    "armed": {"type": "boolean"},
    "failed_requirement_ids": {"type": "array", "items": {"type": "string"}},
    "action": {"type": "string"}
  }
}
