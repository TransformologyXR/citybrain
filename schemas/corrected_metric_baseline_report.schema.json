      "const": "descriptive_only_not_success_bar"
    },
    "calibration_metrics": {
      "type": "object"
    },
    "lead_time_metrics": {
      "type": "object"
    },
    "model_created": {
      "const": false
    },
    "primary_success_metrics": {
      "items": {
        "type": "string"
      },
