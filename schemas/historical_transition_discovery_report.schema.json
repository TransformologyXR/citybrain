{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HistoricalTransitionDiscoveryReport",
  "type": "object",
  "required": [
    "report_id",
    "target_id",
    "status",
    "branch",
    "transition_history_found",
    "classification_counts",
    "source_reports",
    "discovery_policy"
  ],
  "properties": {
    "report_id": {
      "const": "E3_L2_HISTORICAL_TRANSITION_DISCOVERY_REPORT"
    },
    "target_id": {
      "const": "permit_stall_v0"
    },
    "status": {
      "const": "PASS"
    },
    "branch": {
      "enum": [
        "transition_history_present",
        "snapshot_only"
      ]
    },
    "transition_history_found": {
      "type": "boolean"
    },
    "records_scanned": {
      "type": "integer",
      "minimum": 0
    },
    "classification_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "source_reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_family",
          "city_id",
          "records_scanned",
          "classification_counts",
          "candidate_files"
        ],
        "properties": {
          "source_family": {
            "type": "string"
          },
          "city_id": {
            "type": "string"
          },
          "records_scanned": {
            "type": "integer",
            "minimum": 0
          },
          "classification_counts": {
            "type": "object"
          },
          "candidate_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_examples": {
            "type": "array"
          }
        }
      }
    },
    "discovery_policy": {
      "type": "string"
    }
  }
}
