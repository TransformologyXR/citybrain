{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForwardAccumulationPlan",
  "type": "object",
  "required": [
    "plan_id",
    "status",
    "cadence",
    "snapshot_identity_key",
    "diff_materialization_rule",
    "state_transition_inference_policy"
  ],
  "properties": {
    "plan_id": {
      "const": "E3_L2_SNAPSHOT_ONLY_FORWARD_ACCUMULATION_PLAN"
    },
    "status": {
      "const": "PUBLISHED_AS_FALLBACK_POLICY"
    },
    "cadence": {
      "type": "string"
    },
    "snapshot_identity_key": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "diff_materialization_rule": {
      "type": "string"
    },
    "state_transition_inference_policy": {
      "type": "string"
    },
    "minimum_observation_window_days": {
      "type": "integer",
      "minimum": 1
    }
  }
}
