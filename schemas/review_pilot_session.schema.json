{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "eligible_families": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "operator_ref": {
      "type": "string"
    },
    "planned_items": {
      "minimum": 0,
      "type": "integer"
    },
    "session_id": {
      "type": "string"
    },
    "training_fuel_policy": {
      "enum": [
        "human_verified_only",
        "dry_run_non_training"
      ]
    }
  },
  "required": [
    "session_id",
    "operator_ref",
    "planned_items",
    "eligible_families",
    "training_fuel_policy"
  ],
  "title": "Review Pilot Session",
  "type": "object"
}
